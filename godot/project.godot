; Engine configuration file for the Godot port of Sling Drift.
config_version=5

[application]

config/name="Sling Drift"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
; The engine's default Godot-logo splash is replaced with the game's own mark, on
; the same deep-navy the web loader and the UI panels use, so boot -> loader ->
; menu is one continuous look instead of a grey flash.
boot_splash/image="res://assets/ui/boot_splash.png"
boot_splash/bg_color=Color(0.082353, 0.101961, 0.188235, 1)
boot_splash/show_image=true
boot_splash/fullsize=false
boot_splash/use_filter=true

[display]

window/size/viewport_width=420
window/size/viewport_height=820
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
