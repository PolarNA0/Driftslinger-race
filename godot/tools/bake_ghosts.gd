extends SceneTree

# Regenerate scripts/ghostdata.gd from the Godot physics.
#
# The watchable head of each track's board is a set of real runs of the real
# physics, produced by the deterministic policy in scripts/ghostrun.gd. The board
# ships as nothing but (time, id) pairs and re-simulates each ghost from its id on
# demand, so this is the whole data: no positions, no replays.
#
# Run:  godot --headless --path godot --script res://tools/bake_ghosts.gd
#
# Slow (a thousand ids per track, each a full run), so it is a deliberate manual
# step, not part of the verifiers.

const TOP := 10       # watchable runs kept per track
const SCAN := 1000    # ids tried; more ids finds a faster world record


func _init() -> void:
        var out: Dictionary = {}
        for n: int in Tracks.PLAYABLE_TRACKS:
                var track := Track.new(n, Tracks.track_opts(n))
                var found: Array = []
                for id in range(SCAN):
                        var time: Variant = _simulate(track, id)
                        if time != null:
                                found.append([snappedf(float(time), 0.0001), id])
                found.sort_custom(func(a: Array, b: Array):
                        return a[0] < b[0] or (a[0] == b[0] and a[1] < b[1]))
                var top: Array = found.slice(0, mini(TOP, found.size()))
                out[n] = top
                if top.is_empty():
                        print("track %2d: NO finishers" % n)
                else:
                        print("track %2d: WR %.3fs, top %d of %d finishers"
                                % [n, float(top[0][0]), top.size(), found.size()])
        _write(out)


func _simulate(track: Track, id: int) -> Variant:
        var car := Car.new()
        car.reset(track)
        var policy: Callable = GhostRun.ghost_policy(id)
        var i := 0
        var dt := 1.0 / 120.0
        while car.alive and i < 200000:
                i += 1
                car.step(dt, bool(policy.call(car)))
        return car.time if car.finished else null


func _write(out: Dictionary) -> void:
        var body := PackedStringArray()
        for n: int in Tracks.PLAYABLE_TRACKS:
                var rows := PackedStringArray()
                for row: Array in out[n]:
                        rows.append("[%s,%d,%s]" % [str(row[0]), int(row[1]), JSON.stringify(GhostRun.ghost_name(int(row[1])))])
                body.append("  %d: [%s]," % [n, ", ".join(rows)])
        var text := """extends RefCounted
class_name GhostData

# GENERATED by tools/bake_ghosts.gd - do not edit by hand.
# The watchable head of each track's board: [time, ghost_id, name], fastest first.
# A ghost's replay is re-simulated from its id on demand (scripts/ghostrun.gd).
const GHOSTS := {
%s
}
""" % "\n".join(body)
        var f := FileAccess.open("res://scripts/ghostdata.gd", FileAccess.WRITE)
        f.store_string(text)
        f.close()
        print("wrote scripts/ghostdata.gd")
